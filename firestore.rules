rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin(loja) {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/lojas/$(loja)/admins/$(request.auth.token.email));
    }
    function texto(v, max) { return v is string && v.size() <= max; }

    // ponytail: conteúdo de cada item não é validado (regras não fazem laço); o painel escapa tudo e confere o valor
    // site: status 'novo', sem campos extras. Balcão (loja lança): já aceito, com local e aceitoEm
    function pedidoValido(p, status, extras) {
      let campos = ['cod', 'criadoEm', 'status', 'entrega', 'pag', 'troco', 'obs', 'cliente', 'itens', 'subtotal', 'taxa'].concat(extras);
      let c = p.cliente;
      return p.keys().hasOnly(campos) && p.keys().hasAll(campos)
        && p.status == status && p.criadoEm == request.time
        && texto(p.cod, 10) && p.entrega is bool && texto(p.obs, 300)
        && p.pag in ['Pix', 'Cartão de crédito', 'Cartão de débito', 'Dinheiro']
        && p.troco is number && p.troco >= 0 && p.troco <= 1000
        && c is map && c.keys().hasOnly(['nome', 'fone', 'rua', 'numero', 'bairro', 'compl', 'ref', 'loc'])
        && texto(c.nome, 60) && c.nome.size() > 0 && texto(c.fone, 16)
        && texto(c.get('rua', ''), 100) && texto(c.get('numero', ''), 10) && texto(c.get('bairro', ''), 60)
        && texto(c.get('compl', ''), 60) && texto(c.get('ref', ''), 100) && texto(c.get('loc', ''), 40)
        && p.itens is list && p.itens.size() >= 1 && p.itens.size() <= 30
        && p.subtotal is number && p.subtotal > 0 && p.subtotal <= 5000
        && (p.taxa == null || (p.taxa is number && p.taxa >= 0 && p.taxa <= 50));
    }

    // avaliação: o convite (criado pelo painel ao marcar entregue) autoriza UMA avaliação daquele pedido,
    // com nota 1–5 pra cada burger do convite e etiquetas da lista fixa (igual a avaliacao.js)
    function avaliacaoValida(loja, id) {
      let c = get(/databases/$(database)/documents/lojas/$(loja)/convites/$(id)).data;
      let a = request.resource.data;
      let campos = ['notas', 'tags', 'comentarios', 'nome', 'criadoEm', 'vista', 'publicas'];
      return a.keys().hasOnly(campos) && a.keys().hasAll(campos)
        && a.notas is map && a.notas.keys().hasOnly(c.ids) && a.notas.keys().hasAll(c.ids)
        && a.notas.values().hasOnly([1, 2, 3, 4, 5])
        && a.tags is list && a.tags.size() <= 11
        && a.tags.hasOnly(['Saboroso', 'Chegou quente', 'Bem embalado', 'Entrega rápida', 'Bom atendimento',
             'Chegou frio', 'Demorou', 'Faltou item', 'Veio errado', 'Embalagem ruim', 'Sabor deixou a desejar'])
        && a.comentarios is map && a.comentarios.keys().hasOnly(c.ids) && comentariosOk(a.comentarios, c.ids)
        && a.nome == c.nome && a.criadoEm == request.time && a.vista == false && a.publicas == [];
    }
    // um comentário opcional por burger, até 300 letras. Regras não têm laço: confere até 8 burgers diferentes no pedido
    // (o cardápio tem 6). ponytail: cardápio com mais de 8 burgers precisa de mais linhas aqui
    function comentariosOk(m, ids) {
      return (ids.size() < 1 || texto(m.get(ids[0], ''), 300)) && (ids.size() < 2 || texto(m.get(ids[1], ''), 300))
        && (ids.size() < 3 || texto(m.get(ids[2], ''), 300)) && (ids.size() < 4 || texto(m.get(ids[3], ''), 300))
        && (ids.size() < 5 || texto(m.get(ids[4], ''), 300)) && (ids.size() < 6 || texto(m.get(ids[5], ''), 300))
        && (ids.size() < 7 || texto(m.get(ids[6], ''), 300)) && (ids.size() < 8 || texto(m.get(ids[7], ''), 300))
        && ids.size() <= 8;
    }

    match /lojas/{loja} {
      allow read: if true;
      allow write: if admin(loja);

      match /admins/{email} {
        allow read: if request.auth != null && request.auth.token.email == email;
      }
      match /clientes/{fone} {
        allow read, write: if admin(loja);
      }
      match /pedidos/{id} {
        allow create: if pedidoValido(request.resource.data, 'novo', [])
          || (admin(loja) && pedidoValido(request.resource.data, 'preparo', ['local', 'aceitoEm'])
            && request.resource.data.aceitoEm == request.time && request.resource.data.local is bool
            && !(request.resource.data.local && request.resource.data.entrega));
        allow read: if admin(loja);
        allow update: if admin(loja)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'aceitoEm', 'saiuEm', 'entregueEm', 'canceladoEm', 'motivo'])
          && request.resource.data.status in ['novo', 'preparo', 'saiu', 'entregue', 'cancelado'];
      }

      // create em documento que já existe conta como update (negado): uma avaliação por pedido
      match /convites/{id} {
        allow read: if true;
        allow create: if admin(loja);
      }
      match /avaliacoes/{id} {
        allow create: if exists(/databases/$(database)/documents/lojas/$(loja)/convites/$(id))
          && avaliacaoValida(loja, id)
          && existsAfter(/databases/$(database)/documents/lojas/$(loja)/notas/$(id));
        allow read: if admin(loja);
        allow update: if admin(loja) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vista', 'publicas']);
      }
      // só as notas, públicas (média do site); criadas no mesmo lote da avaliação e iguais a ela
      match /notas/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['notas', 'criadoEm'])
          && request.resource.data.criadoEm == request.time
          && request.resource.data.notas == getAfter(/databases/$(database)/documents/lojas/$(loja)/avaliacoes/$(id)).data.notas;
      }
      // comentários que a loja liberou pro site: um por burger, id = <pedido>_<burger>
      match /depoimentos/{id} {
        allow read: if true;
        allow create, delete: if admin(loja);
      }
    }
  }
}
